# Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Dashboard > Project Settings > API Keys > Secret keys
